{
  "name": "tata-kartu-pelajar",
  "version": "1.0.0",
  "description": "Susun foto kartu pelajar otomatis di kertas, simpan PDF siap cetak",
  "main": "main.js",
  "author": "Tata Kartu Pelajar",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64 --publish never"
  },
  "dependencies": {
    "jspdf": "2.5.2"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "id.tatakartu.app",
    "productName": "Tata Kartu Pelajar",
    "files": ["main.js", "preload.js", "index.html"],
    "directories": { "output": "dist" },
    "win": { "target": ["nsis", "portable"] },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
